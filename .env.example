# ---- Database (required in production) ----
# Postgres connection string (Neon / Vercel Postgres). Site builds & browses without it, but checkout/accounts need it.
POSTGRES_URL=

# ---- Auth ----
# Long random string used to sign session JWTs (e.g. `openssl rand -hex 32`).
AUTH_SECRET=

# Comma-separated list of emails allowed into /admin (must also have a normal account).
ADMIN_EMAILS=service@rssolutions.ca
# Sales associates: selling surfaces only (Sales dashboard, Quotes, Invoices —
# full invoice control incl. mark-paid/void/refund). No cost, profit, payroll,
# financial, marketing, customers, operations, or Sarah. Comma-separated.
SALES_EMAILS=

# ---- Stripe Checkout ----
# Secret key from the Stripe dashboard (sk_test_… while testing, sk_live_… when live).
# Leave blank to launch in "pay on pickup/delivery" mode (no online card payment).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) from Stripe → Developers → Webhooks, for the
# endpoint https://bargainbay.ca/api/stripe-webhook. REQUIRED for online payment:
# without it the webhook rejects everything, so orders never get marked paid.
STRIPE_WEBHOOK_SECRET=

# ---- Site ----
# Public origin of the site, used for Stripe success/cancel redirect URLs (e.g. https://bargainbay.ca).
SITE_URL=http://localhost:3000

# ---- Cron protection (optional) ----
# If set, every /api/cron/* endpoint requires Authorization: Bearer <CRON_SECRET>
# (Vercel Cron sends this automatically when CRON_SECRET is defined).
# HEADER ONLY — the ?key=<CRON_SECRET> query form was removed, because a secret
# in a URL ends up in request logs, proxy logs and browser history. To run one
# by hand:
#   curl -X POST -H "Authorization: Bearer $CRON_SECRET" \
#        https://bargainbay.ca/api/cron/sync-inventory
CRON_SECRET=

# ---- Google Sheets (master tracker sync + sold write-back) ----
# Service-account JSON pasted as one line (or a file path). Optional — sheet sync is skipped without it.
GOOGLE_CREDENTIALS=
# Spreadsheet ID of the master inventory tracker.
SHEET_ID=1hFYsg-sqx4YSIMxjMzEa3D0NoNjrUnow
# Tab name inside the tracker (defaults to 'Main').
GOOGLE_SHEETS_TAB=Main
# Set to 1 to let paid orders write "Sold" back to the master tracker (needs GOOGLE_CREDENTIALS + SHEET_ID).
SHEET_WRITEBACK=0

# ---- Google Places (invoice address autocomplete) ----
# Optional. A Google Maps JS API key with the Places API enabled (restrict it to
# your domain). Without it, the invoice address fields are plain text inputs.
# NEXT_PUBLIC = baked at build time, so redeploy after setting it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Email (Resend) ----
# API key from resend.com. Without it, all emails are a logged no-op.
RESEND_API_KEY=
# The "from" address. MUST be on a domain you've verified in Resend (e.g.
# bargainbay.ca). A Gmail/free address will be REJECTED as a sender. The
# default onboarding@resend.dev only delivers to your own Resend login.
RESEND_FROM=Bargain Bay <sales@bargainbay.ca>
# Where owner notifications (new orders, member applications) are delivered.
# This is just a recipient, so a Gmail is fine.
NOTIFY_EMAIL=bargain.bay.save@gmail.com

# ---- SMS / text campaigns (Twilio) ----
# From the Twilio console. Needed for the Campaigns → SMS channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. +16475551234. Also the number
# the import review calls out FROM, so it has to be voice-capable.
TWILIO_FROM=

# ---- The import review call (dispatch) ----
# When a client's sheet is staged on /admin/dispatch, "Call me about this" rings
# this number, reads the sheet out and takes the answers as speech. Nothing goes
# on the board until the caller says so.
#
# The number is deliberately NOT taken from the browser at call time: a review
# call that can be pointed at an arbitrary number is a robocaller with our name
# on it. Set it here, or leave this blank and set it on the Clients & drivers
# tab (setting `dispatch_call_to`) — the env var wins.
# E.164, e.g. +14165551234.
DISPATCH_CALL_TO=
# Model that runs the conversation. Sonnet by default: a phone call is a latency
# budget, and every turn is a round trip the caller is listening to.
DISPATCH_CALL_MODEL=claude-sonnet-5
# The webhook URL and the audio URL are the RS host (the same address an RS
# invoice links to), NOT SITE_URL — a dispatch call must never advertise
# bargainbay.ca. Override with RS_SITE_URL; unset it defaults to
# https://dispatch.rssolutions.ca.
#
# The call also needs ANTHROPIC_API_KEY (it already exists for PDF imports and
# supplier invoices) and, for a voice that isn't Twilio's own, ELEVENLABS_API_KEY
# — the same key lib/voice.js already uses for Sarah. With no ElevenLabs key it
# falls back to a Polly voice rather than to silence.

# ---- RS Manager — the crew's AI assistant (optional) ----
# Drivers, sales and warehouse staff talk to it from the corner of /driver and
# every portal page; RS Ops calls /api/ops/assistant with RSOPS_INTAKE_KEY.
# Needs ANTHROPIC_API_KEY; voice needs ELEVENLABS_API_KEY (text works without).
ASSISTANT_MODEL=claude-opus-5
# low | medium | high — somebody is standing in a doorway waiting on each turn.
ASSISTANT_EFFORT=medium
# Questions per person per 10 minutes before it asks them to slow down.
ASSISTANT_RATE_MAX=40
# Punjabi replies are spoken by ElevenLabs v3 (multilingual_v2 has no Punjabi).
ELEVENLABS_MODEL_V3=eleven_v3
ELEVENLABS_STT_MODEL=scribe_v1

# ---- Meta Pixel (optional) ----
# Facebook/Instagram pixel ID; enables ViewContent/AddToCart/Purchase tracking.
NEXT_PUBLIC_FB_PIXEL_ID=

# ---- Images ----
# Optional remote base URL for per-unit photos (<base>/<UID>/main.jpg). Local photos in public/images/<UID>/main.jpg win; otherwise category placeholders are used.
IMAGES_BASE_URL=

# ---- QuickBooks Online (automatic expense tracking) ----
# Dormant until both are set. One-time setup:
#   1. developer.intuit.com → Create an app → QuickBooks Online Accounting.
#   2. The app's PRODUCTION keys page → add redirect URI
#      https://bargainbay.ca/api/admin/qbo/callback → copy Client ID + Secret.
#   3. Set these in Vercel, redeploy, then /admin/financial → "Connect QuickBooks".
# The nightly finance cron pulls Purchases + Bills (money out) into the expense
# ledger, WITH the tax on them — that tax is the input tax credit half of the
# HST remittance figure.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# 'sandbox' points at Intuit's test company. Leave unset for the real books.
QBO_ENV=

# ---- Bank feed (Plaid) ----
# Links the TD account (and any card) straight into the expense ledger.
# Transactions arrive minutes after they settle via the webhook, and again on
# the nightly finance pass. Dormant until these are set.
#   1. dashboard.plaid.com → request PRODUCTION access, country Canada,
#      product Transactions. (Canada + production needs Plaid's approval.)
#   2. Team Settings → Keys: client_id + the production secret.
#   3. Developers → Webhooks: https://bargainbay.ca/api/plaid/webhook
#   4. Set these in Vercel, redeploy, then /admin/financial → "Connect a bank".
# An imported bank line is a GROSS charge with no tax figure — the bank never saw
# the receipt. "HST to confirm" on the Financial tab is where that gets answered.
PLAID_CLIENT_ID=
PLAID_SECRET=
# 'sandbox' uses Plaid's fake banks — fine for a dry run, but the data is not
# yours. Leave as production for the real thing.
PLAID_ENV=production

# ---- Fake-order defences (all optional; sensible defaults in lib/antifraud.js) ----
# Card payments are off (CARD_PAYMENTS_ENABLED), so an order reserves a qty-1
# unit with no payment step. These knobs tune the controls that replace it, and
# can be tightened in Vercel without a code deploy. Every check degrades OPEN:
# if the database is unreachable the order goes through.
# Orders one IP may place per hour (default 3).
ABUSE_MAX_ORDERS_PER_IP=
# Orders one email may place per hour (default 2).
ABUSE_MAX_ORDERS_PER_EMAIL=
# Units one buyer may hold unpaid at once (default 5).
ABUSE_MAX_UNPAID_UNITS=
# Accounts one IP may create per hour (default 3).
ABUSE_MAX_SIGNUPS_PER_IP=
# Hours a guest order may hold its unit before the "confirm your email" link is
# clicked (default 12). Deliberately long enough to survive ordering overnight.
ORDER_VERIFY_HOURS=
# Days an unpaid offline (e-transfer / pay-on-pickup) order holds its unit before
# it auto-cancels and the unit relists (default 7).
UNPAID_ORDER_DAYS=

# ---- Truck trackers (Salind / PAJ FINDER portal) ----
# A Salind device is sealed and locked to PAJ's portal — it cannot be pointed at
# a server of our own, so we poll theirs. These are the FINDER portal sign-in;
# both are required or nothing is read at all (lib/paj-gps.js pajConfigured()).
# Unset, the feature is simply off: no tracker is polled and nobody is emailed.
#
# Pair a device to a van under People & access on dispatch — the van carries the
# device id, and the Live tab shows it alongside the drivers' phones.
PAJ_EMAIL=
PAJ_PASSWORD=
# Only if PAJ move the API. Defaults to https://connect.paj-gps.de/api/v1.
PAJ_API_URL=

# ---------------------------------------------------------------------------
# Error reporting (lib/observe.js). Everything below is OPTIONAL — with
# SENTRY_DSN unset, captureError/captureMessage are no-ops and the app is
# exactly as it was. Set it and failures stop being invisible.
#
# There is no SDK: this posts a Sentry envelope over plain HTTPS, the same way
# lib/sms.js talks to Twilio. Any Sentry-compatible ingest endpoint works.
# SENTRY_DSN=https://<publicKey>@<host>/<projectId>
#
# Defaults to VERCEL_GIT_COMMIT_SHA / VERCEL_ENV, which is normally what you
# want. Override only if you tag releases differently.
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=

# ---------------------------------------------------------------------------
# Database TLS (lib/db.js). Neon and Vercel Postgres present a public-CA
# certificate that Node verifies with no configuration, so neither of these is
# normally needed.
#
# A PEM bundle, for a provider using a private CA:
# POSTGRES_CA_CERT=
#
# ESCAPE HATCH, NOT A SETTING. '1' restores the old behaviour of accepting ANY
# certificate. If you need it, something is wrong with the cert chain — find out
# what before leaving this on. It logs a warning on every cold start.
# POSTGRES_SSL_INSECURE=

# ---------------------------------------------------------------------------
# TWO SENDING NUMBERS, and the reason is not tidiness.
#
# TWILIO_FROM is the OPERATIONS number: driver sign-in codes, sign-in links,
# shift nudges, and the outbound import-review call.
# TWILIO_MARKETING_FROM carries Bargain Bay adverts and nothing else.
#
# They must differ because Twilio's STOP handling blocks a NUMBER PAIR at
# carrier level, not a kind of message. On one shared number, a driver who is
# swept into a marketing blast and texts STOP can no longer receive a sign-in
# code — and the send just fails, so nobody finds out until they are standing
# at a van. The same trap catches customer delivery notifications once those
# ship.
#
# UNSET IS SAFE BUT NOT SILENT: marketing falls back to TWILIO_FROM so
# campaigns keep working, and the composer says on screen that it did.
# TWILIO_MARKETING_FROM=

# ---------------------------------------------------------------------------
# Inbound SMS (app/api/sms/inbound) — this is what makes "Reply STOP" true.
# POINT BOTH NUMBERS' "A MESSAGE COMES IN" WEBHOOK AT IT. The route records
# which number was texted, because a STOP to the marketing number costs
# somebody adverts and a STOP to the operations number locks a driver out.
# Point the Twilio number's "A MESSAGE COMES IN" webhook at
#   https://bargainbay.ca/api/sms/inbound
# It uses TWILIO_AUTH_TOKEN (already set above) to verify the signature.
#
# Only needed if the public URL Twilio signs differs from the one the app sees
# (a proxy in front, a different host):
# TWILIO_SMS_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# STAGING SAFETY (lib/environment.js). Ignored entirely in production.
#
# A staging or preview deployment shares these environment variables with
# production unless somebody remembers otherwise, so by default a non-production
# deployment would email real customers, text real drivers, and write "Sold"
# into the master tracker. It cannot: outside production, email and SMS are
# REDIRECTED to the addresses below, and tracker writes and outbound calls are
# REFUSED outright.
#
# With these UNSET, nothing is sent at all — staging fails closed.
# STAGING_EMAIL_TO=staging@rssolutions.ca
# STAGING_SMS_TO=+14374888549
#
# The escape hatch, for a deliberate local run against production data (a data
# fix, a migration rehearsal). Must be spelled exactly; "true" and "1" do not
# work, on purpose. Logs a warning every time it is used.
# ALLOW_REAL_OUTBOUND=yes-i-mean-it
