# ---- Database (required in production) ----
# Postgres connection string (Neon / Vercel Postgres). Site builds & browses without it, but checkout/accounts need it.
POSTGRES_URL=

# ---- Auth ----
# Long random string used to sign session JWTs (e.g. `openssl rand -hex 32`).
AUTH_SECRET=

# Comma-separated list of emails allowed into /admin (must also have a normal account).
ADMIN_EMAILS=service@rssolutions.ca
# Sales associates: selling surfaces only (Sales dashboard, Quotes, Invoices —
# full invoice control incl. mark-paid/void/refund). No cost, profit, payroll,
# financial, marketing, customers, operations, or Sarah. Comma-separated.
SALES_EMAILS=

# ---- Stripe Checkout ----
# Secret key from the Stripe dashboard (sk_test_… while testing, sk_live_… when live).
# Leave blank to launch in "pay on pickup/delivery" mode (no online card payment).
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…) from Stripe → Developers → Webhooks, for the
# endpoint https://bargainbay.ca/api/stripe-webhook. REQUIRED for online payment:
# without it the webhook rejects everything, so orders never get marked paid.
STRIPE_WEBHOOK_SECRET=

# ---- Site ----
# Public origin of the site, used for Stripe success/cancel redirect URLs (e.g. https://bargainbay.ca).
SITE_URL=http://localhost:3000

# ---- Cron protection (optional) ----
# If set, /api/cron/expire-reservations requires Authorization: Bearer <CRON_SECRET>
# (Vercel Cron sends this automatically when CRON_SECRET is defined) or ?key=<CRON_SECRET>.
CRON_SECRET=

# ---- Google Sheets (master tracker sync + sold write-back) ----
# Service-account JSON pasted as one line (or a file path). Optional — sheet sync is skipped without it.
GOOGLE_CREDENTIALS=
# Spreadsheet ID of the master inventory tracker.
SHEET_ID=1hFYsg-sqx4YSIMxjMzEa3D0NoNjrUnow
# Tab name inside the tracker (defaults to 'Main').
GOOGLE_SHEETS_TAB=Main
# Set to 1 to let paid orders write "Sold" back to the master tracker (needs GOOGLE_CREDENTIALS + SHEET_ID).
SHEET_WRITEBACK=0

# ---- Google Places (invoice address autocomplete) ----
# Optional. A Google Maps JS API key with the Places API enabled (restrict it to
# your domain). Without it, the invoice address fields are plain text inputs.
# NEXT_PUBLIC = baked at build time, so redeploy after setting it.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---- Email (Resend) ----
# API key from resend.com. Without it, all emails are a logged no-op.
RESEND_API_KEY=
# The "from" address. MUST be on a domain you've verified in Resend (e.g.
# bargainbay.ca). A Gmail/free address will be REJECTED as a sender. The
# default onboarding@resend.dev only delivers to your own Resend login.
RESEND_FROM=Bargain Bay <sales@bargainbay.ca>
# Where owner notifications (new orders, member applications) are delivered.
# This is just a recipient, so a Gmail is fine.
NOTIFY_EMAIL=bargain.bay.save@gmail.com

# ---- SMS / text campaigns (Twilio) ----
# From the Twilio console. Needed for the Campaigns → SMS channel.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number in E.164 format, e.g. +16475551234. Also the number
# the import review calls out FROM, so it has to be voice-capable.
TWILIO_FROM=

# ---- The import review call (dispatch) ----
# When a client's sheet is staged on /admin/dispatch, "Call me about this" rings
# this number, reads the sheet out and takes the answers as speech. Nothing goes
# on the board until the caller says so.
#
# The number is deliberately NOT taken from the browser at call time: a review
# call that can be pointed at an arbitrary number is a robocaller with our name
# on it. Set it here, or leave this blank and set it on the Clients & drivers
# tab (setting `dispatch_call_to`) — the env var wins.
# E.164, e.g. +14165551234.
DISPATCH_CALL_TO=
# Model that runs the conversation. Sonnet by default: a phone call is a latency
# budget, and every turn is a round trip the caller is listening to.
DISPATCH_CALL_MODEL=claude-sonnet-5
# The webhook URL and the audio URL are the RS host (the same address an RS
# invoice links to), NOT SITE_URL — a dispatch call must never advertise
# bargainbay.ca. Override with RS_SITE_URL; unset it defaults to
# https://dispatch.rssolutions.ca.
#
# The call also needs ANTHROPIC_API_KEY (it already exists for PDF imports and
# supplier invoices) and, for a voice that isn't Twilio's own, ELEVENLABS_API_KEY
# — the same key lib/voice.js already uses for Sarah. With no ElevenLabs key it
# falls back to a Polly voice rather than to silence.

# ---- Meta Pixel (optional) ----
# Facebook/Instagram pixel ID; enables ViewContent/AddToCart/Purchase tracking.
NEXT_PUBLIC_FB_PIXEL_ID=

# ---- Images ----
# Optional remote base URL for per-unit photos (<base>/<UID>/main.jpg). Local photos in public/images/<UID>/main.jpg win; otherwise category placeholders are used.
IMAGES_BASE_URL=

# ---- QuickBooks Online (automatic expense tracking) ----
# Dormant until both are set. One-time setup:
#   1. developer.intuit.com → Create an app → QuickBooks Online Accounting.
#   2. The app's PRODUCTION keys page → add redirect URI
#      https://bargainbay.ca/api/admin/qbo/callback → copy Client ID + Secret.
#   3. Set these in Vercel, redeploy, then /admin/financial → "Connect QuickBooks".
# The nightly finance cron pulls Purchases + Bills (money out) into the expense
# ledger, WITH the tax on them — that tax is the input tax credit half of the
# HST remittance figure.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# 'sandbox' points at Intuit's test company. Leave unset for the real books.
QBO_ENV=

# ---- Bank feed (Plaid) ----
# Links the TD account (and any card) straight into the expense ledger.
# Transactions arrive minutes after they settle via the webhook, and again on
# the nightly finance pass. Dormant until these are set.
#   1. dashboard.plaid.com → request PRODUCTION access, country Canada,
#      product Transactions. (Canada + production needs Plaid's approval.)
#   2. Team Settings → Keys: client_id + the production secret.
#   3. Developers → Webhooks: https://bargainbay.ca/api/plaid/webhook
#   4. Set these in Vercel, redeploy, then /admin/financial → "Connect a bank".
# An imported bank line is a GROSS charge with no tax figure — the bank never saw
# the receipt. "HST to confirm" on the Financial tab is where that gets answered.
PLAID_CLIENT_ID=
PLAID_SECRET=
# 'sandbox' uses Plaid's fake banks — fine for a dry run, but the data is not
# yours. Leave as production for the real thing.
PLAID_ENV=production
